# EncorePay Job Monitoring Configuration
# Copy this file to src/main/resources/config.properties and fill in your values
# For CI/CD, use GitHub Secrets instead (see .github/workflows/job-monitoring.yml)

# Application URL (single client mode)
# url=https://your-encorepay-instance.com

# Browser: chrome, firefox, edge
browser=chrome

# Default credentials (used when client-specific credentials not provided)
username=your-username
password=your-password

# Business timezone for reporting (default: Asia/Kolkata)
businessZone=Asia/Kolkata

# Timeouts (seconds)
implicitWait=0
explicitWait=20
pageLoadTimeout=45
bootTimeout=90
overlayTimeout=8
transientFeedbackTimeout=10

# SSO configuration
sso=false

# Client configuration (multi-client mode)
# Option 1: Comma-separated URLs
# clientUrls=https://client1.example.com,https://client2.example.com

# Option 2: Indexed clients (CLIENT_1_URL, CLIENT_2_URL, etc.)
# client.1.url=https://client1.example.com
# client.1.name=Client One
# client.1.username=user1
# client.1.password=pass1
# client.1.sso=false
#
# client.2.url=https://client2.example.com
# client.2.name=Client Two
# client.2.username=user2
# client.2.password=pass2
# client.2.sso=true

# Google Chat Notifications
googleChatWebhookUrl=https://chat.googleapis.com/v1/spaces/.../messages?key=...
# OR OAuth2 (if webhook not available)
# googleChatOAuthClientId=your-client-id
# googleChatOAuthClientSecret=your-client-secret
# googleChatOAuthRefreshToken=your-refresh-token

# Email Notifications
reportEmailEnabled=false
reportEmailTo=recipient@example.com
reportEmailCc=cc@example.com
smtpHost=smtp.gmail.com
smtpPort=587
smtpUsername=sender@gmail.com
smtpPassword=app-password